# Environment variables this project reads. Copy relevant values into:
#   - Render's dashboard -> your service -> Environment tab (for the deployed
#     app: the sign-in gate and the in-browser critical-alert email)
#   - GitHub -> repo Settings -> Secrets and variables -> Actions (for the
#     scheduled fleet-check automation -- see automation/README.md)
# Never commit an actual .env file with real values -- this repo is public.
# Every variable below is optional: leaving any group unset disables that
# feature with no code change and no crash (see auth.py / email_alerts.py).

# --- Sign-in gate (auth.py) ---
# Leave both unset to keep the deployed app open with no login screen.
APP_LOGIN_ID=
APP_PASSWORD=

# --- SMTP, for critical/elevated-risk alert emails (email_alerts.py) ---
# All five are required together; leaving any one unset disables alerting.
# SMTP_PASSWORD must be an app password, not your normal account password --
# Gmail (and most providers) reject plain account passwords for SMTP.
# Set these as Render env vars for the in-browser alert (live_feed.py), and
# separately as GitHub Actions secrets for the scheduled check
# (scripts/check_and_alert.py) -- two different systems, same 5 names.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
